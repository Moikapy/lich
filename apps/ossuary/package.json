{
  "name": "@moikapy/ossuary",
  "version": "0.0.0",
  "private": true,
  "description": "Ossuary — Electron desktop shell for Lich (spawns lich serve)",
  "type": "module",
  "main": "./dist/electron/main.js",
  "scripts": {
    "postinstall": "bun run scripts/ensure_electron.ts",
    "build:renderer": "vite build",
    "build:electron": "bun run scripts/build_electron.ts",
    "build": "bun run build:renderer && bun run build:electron",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun x vitest run",
    "dev": "bun run scripts/ensure_electron.ts && bun run scripts/dev.ts",
    "start": "bun run scripts/ensure_electron.ts && bun run build && electron ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dockview-react": "^8.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/get": "^5.1.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^35.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
